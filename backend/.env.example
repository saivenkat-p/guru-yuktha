# Guru Yuktha Backend Environment Configuration
PROJECT_NAME="Guru Yuktha — Academic Navigation & Tracking System"
ENVIRONMENT=production

# Database Configuration (Use PostgreSQL connection string on Render / Supabase / Neon)
DATABASE_URL=postgresql://guruyuktha_user:your_secure_password@dpg-xxxx-a.render.com/guruyuktha_db

# Security & JWT Authentication (Generate a long random secret key)
SECRET_KEY=generate_a_secure_random_secret_key_minimum_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma-separated URLs of your deployed frontend and local dev)
CORS_ORIGINS=https://guru-yuktha.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Demo Data Seeding (Set to false for production to prevent fake users/data)
SEED_DEMO_DATA=false
